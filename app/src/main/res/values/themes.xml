<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SplitWise" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- ✨ 1. Create a new theme for the splash screen ✨ -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background -->
        <item name="windowSplashScreenBackground">@color/splash</item> <!-- Or your app's main background color -->

        <!-- Set the splash screen icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item> <!-- Or your custom app logo -->

        <!-- Set the theme to transition to after the splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.SplitWise</item>
    </style>
</resources>